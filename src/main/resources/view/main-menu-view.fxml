<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" fx:id="mainContainer" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.johnlab.radforduniversity.controller.MainMenuController">
    <stylesheets>
        <URL value="@/main/resources/css/main-menu.css" />
    </stylesheets>
   <children>
      <BorderPane styleClass="background" stylesheets="@../css/main-menu.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Pane prefHeight="92.0" prefWidth="600.0" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fitHeight="91.0" fitWidth="602.0">
                     <image>
                        <Image url="@../images/triangulos.jpg" />
                     </image>
                  </ImageView>
                  <ImageView fitHeight="74.0" fitWidth="74.0" layoutX="28.0" layoutY="9.0">
                     <image>
                        <Image url="@../images/logo.png" />
                     </image>
                  </ImageView>
                  <Label fx:id="lblWelcomeUser" layoutX="126.0" layoutY="26.0" styleClass="label-title" stylesheets="@../css/main-menu.css" text="Label" />
               </children>
            </Pane>
         </top>
         <left>
            <Pane prefHeight="353.0" prefWidth="175.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox layoutX="-1.0" layoutY="-1.0" prefHeight="355.0" prefWidth="177.0" spacing="20.0">
                     <children>
                        <Label prefHeight="28.0" prefWidth="91.0" styleClass="label-subtitle" stylesheets="@../css/main-menu.css" text="Navegación">
                           <VBox.margin>
                              <Insets left="33.0" />
                           </VBox.margin></Label>
                        <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="155.0" text="Inicio" />
                        <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="155.0" text="Perfil" />
                        <Button mnemonicParsing="false" prefWidth="155.0" text="Configuración" />
                        <Button mnemonicParsing="false" onAction="#mostrarCategorias" prefHeight="40.0" prefWidth="155.0" text="Gestión de Libros" />
                        <Button layoutX="20.0" layoutY="258.0" mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="155.0" text="Cerrar Sesión" />
                     </children>
                     <padding>
                        <Insets left="10.0" right="5.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
            </Pane>
         </left>
         <right>
            <Pane prefHeight="353.0" prefWidth="110.0" BorderPane.alignment="CENTER" />
         </right>
         <bottom>
            <Pane prefHeight="99.0" prefWidth="600.0" BorderPane.alignment="CENTER" />
         </bottom>
         <center>
            <Pane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <ComboBox fx:id="cbCategorias" layoutX="32.0" layoutY="68.0" prefHeight="36.0" prefWidth="250.0" promptText="Elige una categoría" visible="false" />
                  <Label fx:id="lblCategorias" layoutX="80.0" layoutY="24.0" styleClass="label-subtitle" stylesheets="@../css/main-menu.css" text="Acceso a Categorías " visible="false" />
               </children>
            </Pane>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
